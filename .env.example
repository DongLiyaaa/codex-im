# 用 scripts/init_env.py 生成独立随机密钥；不提交实际 .env
POSTGRES_PASSWORD=replace_with_random_hex
SESSION_SECRET=replace_with_at_least_32_random_characters
RUNNER_TOKEN=replace_with_at_least_32_random_characters
# 可选：仅自动化部署显式填写；留空则通过网页初始化管理员
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
APP_ORIGIN=http://127.0.0.1:18200
# 仅 Docker Compose 使用：网页在宿主机上的监听地址与端口（APP_ORIGIN 必须与浏览器实际访问的地址一致）
HUB_BIND=127.0.0.1
HUB_PORT=18200
OPENAI_API_KEY=
CODEX_MODEL=
# 可选：OpenAI 兼容的第三方端点（须是公网 https，且必须配合上面的 API Key 与 CODEX_AUTH_MODE=api；不能与 ChatGPT 登录同用）。
# 例如 https://models.example.com/v1 ；模型名要与该端点 /models 列出的 id 完全一致。
CODEX_BASE_URL=
# webhook keeps legacy callbacks; set websocket/stream to enable dedicated IM processes.
FEISHU_TRANSPORT=webhook
DINGTALK_TRANSPORT=webhook
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_ACCESS_TOKEN=
DINGTALK_ROBOT_SECRET=
DINGTALK_ROBOT_CHAT_ID=
# Personal OAuth: separate from bot configuration; missing values produce setup_required.
PLATFORM_BRIDGE_KEY=replace_with_random_hex
PLATFORM_BRIDGE_URL=http://127.0.0.1:18200/internal/platform-mcp
PLATFORM_AUTH_KEY=
PLATFORM_FEISHU_CLIENT_ID=
PLATFORM_FEISHU_CLIENT_SECRET=
PLATFORM_DINGTALK_CLIENT_ID=
PLATFORM_DINGTALK_CLIENT_SECRET=
# 独立附件worker/API共享私有存储；runner通过短效能力取件，不挂载原始文件。
ATTACHMENT_BRIDGE_URL=http://127.0.0.1:18200/internal/attachment-mcp
# 留空时不要设置该变量；默认本项目 .runtime/attachments
# ATTACHMENT_ROOT=/absolute/private/attachments
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_MAX_FILES=5
ATTACHMENT_DRAFT_HOURS=24
ATTACHMENT_PARSE_SECONDS=45
ATTACHMENT_LEASE_SECONDS=180
ATTACHMENT_MAX_ATTEMPTS=3
ATTACHMENT_IMAGE_PIXELS=25000000
ATTACHMENT_ZIP_ENTRIES=2000
ATTACHMENT_ZIP_EXPANDED_BYTES=67108864
ATTACHMENT_CELLS=100000
ATTACHMENT_PDF_PAGES=200
ATTACHMENT_DINGTALK_DOWNLOAD_DOMAINS=dingtalk.com,dingtalkapps.com,alicdn.com,aliyuncs.com
# 默认0：非macOS且无隔离实现时失败关闭；1仅允许受资源限制子进程，不是真沙箱。
ATTACHMENT_ALLOW_PROCESS_ONLY=0

# 可选：Codex 模型连接的出站代理（http/https/socks5），本机地址自动绕过；留空为直连
CODEX_PROXY_URL=
